    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "@tailwindcss/postcss": "4.1.17",
    "postcss": "8.5.33",
    "vitest": "5.1.2",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/dom": "10.4.1",
    "jsdom": "26.1.0"
